@@ -37,6 +37,12 @@ def file_exists_local_or_remote(file_path: str) -> bool:
 @retry()
 def open_local_or_remote(file_path: str, mode: str = "r") -> BinaryIO:
     fs, _ = url_to_fs(file_path)
+    # Hydra creates a fresh timestamped output dir per run, so write targets such as
+    # metadata/ and checkpoints/ do not exist yet. fs.open does not create them.
+    if any(m in mode for m in ("w", "a", "x")):
+        parent = os.path.dirname(file_path)
+        if parent:
+            fs.makedirs(parent, exist_ok=True)
     return fs.open(file_path, mode)
 
 
