# macOS
.DS_Store
._*

# Python
__pycache__/
*.pyc
.venv/
venv/

# 실험 산출물 (대용량 — 레포에 올리지 않음)
build/
grid_data/
*.pkl
*.pt
outputs/runs/
logs/runs/

# 단, 공유하기로 한 산출물은 예외
!embeddings/**/*.pt
!sid/**/*.pt
# 평가는 이 split 들 위에서만 성립한다. 재전처리를 돌리면 아이템 인기도가 달라지고
# 롱테일 집합·콜드 버킷 경계가 다른 아이템 위에 그어진다. 그래서 재생성 레시피가 아니라
# 파일 자체를 공유한다. (preprocessing/repreprocess.py 가 만드는 것과 같은 파일)
!Beauty_split_A.pkl
!Beauty_split_B.pkl
!Beauty_related_separate.pkl
!_archive/data/*.pkl

# 구인구직 생성 데이터셋 (data_gen/out) — Beauty split 과 같은 이유로 파일 자체를 공유한다.
# 재생성하면 아이템 인기도가 달라져 롱테일·콜드 버킷 경계가 다른 아이템 위에 그어진다.
!data_gen/out/Jobs_split_A.pkl
!data_gen/out/Jobs_split_B.pkl

# 재수집·재생성 가능하거나 너무 큰 것은 올리지 않는다
data_gen/raw/
data_gen/tmp/
data_gen/out/v1_failed/
# 고용24 원본 XML 2.0GB 는 fetch_work24.py 로 재수집한다.
# jobs_text_emb.pt (98MB) 는 위 *.pt 규칙으로 이미 제외 — embed_jobs.py 로 재생성한다.

# 서버 접속 가이드(docs/GPU_서버_사용가이드.md)는 private 저장소인 동안에만 포함합니다.
# public 으로 전환할 때는 파일 삭제 + 비밀번호 변경 + 히스토리 정리가 필요합니다.


# macOS 리소스 포크(._*)는 위의 !예외 규칙들보다 뒤에 있어야 한다.
# gitignore 는 마지막 매칭이 이기므로, 앞쪽 `._*` 는 !sid/**/*.pt 등에 덮인다.
._*

# API 인증키 — 절대 커밋하지 않는다 (공개 저장소 전환 대비)
.env
.env.*
!.env.example
secrets/

# v4 외부 데이터(캐글 등)는 저장소 밖 D:/DSL/_external 에 둔다. 혹시 안에 두더라도 올리지 않는다.
data_gen/external/
data_gen/v4/out/
